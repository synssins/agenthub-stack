 }
 
 #if defined(DPCT_COMPATIBILITY_TEMP) && DPCT_COMPATIBILITY_TEMP >= 800 &&      \
-    !defined(__HIPCC__)
+    !defined(__HIPCC__) && !defined(STRATA_NVPTX_TURING)   // four-gpu: no cp.async on sm_75
 #define STRATA_GR_CP_ASYNC 1
 #endif
 __dpct_inline__ void cp_async16(void *smem, const void *gmem) {
@@ -1258,7 +1258,7 @@ __dpct_inline__ void cp_async16(void *smem, const void *gmem) {
             *(((uint32_t *)(uintptr_t)gmem) + 3);
 #endif
 #else
-    *reinterpret_cast<float4*>(smem) = *reinterpret_cast<const float4*>(gmem);
+    *reinterpret_cast<sycl::float4*>(smem) = *reinterpret_cast<const sycl::float4*>(gmem);   // four-gpu: sycl::float4
 #endif
 }
 __dpct_inline__ void cp_async_commit() {
