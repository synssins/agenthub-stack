From e0053a16f9860aaa2e495d83353175eabb276f99 Mon Sep 17 00:00:00 2001
From: AgentHub stack <noreply@example.invalid>
Date: Mon, 19 Oct 2026 15:05:16 +0000
Subject: [PATCH 01/17] four-gpu: build the SYCL engine for NVIDIA (sm_75)
 alongside Intel

- dpct SHFL_SYNC: sycl::bit_cast for the NVVM bitcast builtins
- XMX kernels: joint_matrix via a no-op stand-in in the NVPTX pass
- Turing: two m16n8k8 MMAs; no cp.async (STRATA_NVPTX_TURING)
- fused_gr fallback copy: sycl::float4

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 sycl/include/dpct/util.hpp                    |  4 ++--
 sycl/include/strata/jm_portable.hpp           | 22 +++++++++++++++++++
 sycl/src/kernels/cuda/fused_gr.dp.cpp         |  4 ++--
 sycl/src/kernels/cuda/iq_kernels.dp.cpp       |  5 +++--
 sycl/src/kernels/cuda/qsa_prompt_attn.dp.cpp  | 10 ++++++++-
 .../kernels/cuda/qsa_prompt_attn_xmx.dp.cpp   |  3 ++-
 sycl/src/prefill/xmx_moe.dp.cpp               |  3 ++-
 7 files changed, 42 insertions(+), 9 deletions(-)
 create mode 100644 sycl/include/strata/jm_portable.hpp

diff --git a/sycl/include/dpct/util.hpp b/sycl/include/dpct/util.hpp
index 033f6c7..125b8be 100644
--- a/sycl/include/dpct/util.hpp
+++ b/sycl/include/dpct/util.hpp
@@ -443,8 +443,8 @@ namespace experimental {
     asm("mov.b16 %0,%1;" : "=h"(RES) : "h"(static_cast<short>(tmp_b32)));      \
   } else if constexpr (std::is_same_v<T, float>) {                             \
     auto tmp_b32 = __nvvm_shfl_sync_##SHUFFLE_INSTR(                           \
-        MASK, __nvvm_bitcast_f2i(VAL), SHFL_PARAM, C);                         \
-    RES = __nvvm_bitcast_i2f(tmp_b32);                                         \
+        MASK, sycl::bit_cast<int>(VAL), SHFL_PARAM, C);                         \
+    RES = sycl::bit_cast<float>(tmp_b32);                                         \
   } else {                                                                     \
