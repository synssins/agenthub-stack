diff --git a/sycl/include/strata/jm_portable.hpp b/sycl/include/strata/jm_portable.hpp
new file mode 100644
index 0000000..594a420
--- /dev/null
+++ b/sycl/include/strata/jm_portable.hpp
@@ -0,0 +1,22 @@
+// four-gpu: the XMX kernels' joint_matrix namespace.  On every target but NVIDIA it is SYCL's own; in the NVPTX device
+// pass it is a no-op stand-in, because Intel's XMX tile shapes (8x16x16, ext_intel_packed) have no NVIDIA form.  The
+// kernel bodies and their captures stay identical on both passes; the XMX paths are never launched on a CUDA device.
+#pragma once
+#include <sycl/sycl.hpp>
+
+#if defined(__SYCL_DEVICE_ONLY__) && defined(__NVPTX__)
+namespace strata::jm_stub {
+using sycl::ext::oneapi::experimental::matrix::use;
+using sycl::ext::oneapi::experimental::matrix::layout;
+template <typename Group, typename T, use U, size_t Rows, size_t Cols, layout L = layout::dynamic>
+struct joint_matrix { T unused; };
+template <typename Group, typename M, typename T> inline void joint_matrix_fill(Group, M&, const T&) {}
+template <typename Group, typename M, typename... A> inline void joint_matrix_load(Group, M&, A...) {}
+template <typename Group, typename M, typename... A> inline void joint_matrix_store(Group, const M&, A...) {}
+template <typename Group, typename D, typename A, typename B, typename C>
+inline void joint_matrix_mad(Group, D&, const A&, const B&, const C&) {}
+}  // namespace strata::jm_stub
+namespace strata_jm = strata::jm_stub;
+#else
+namespace strata_jm = sycl::ext::oneapi::experimental::matrix;
+#endif
