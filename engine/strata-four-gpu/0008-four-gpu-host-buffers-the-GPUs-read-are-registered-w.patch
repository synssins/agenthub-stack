diff --git a/sycl/include/strata/host_visible.hpp b/sycl/include/strata/host_visible.hpp
new file mode 100644
index 0000000..e0331a2
--- /dev/null
+++ b/sycl/include/strata/host_visible.hpp
@@ -0,0 +1,62 @@
+// four-gpu: host memory that every card can read.  The engine hands GPUs host buffers to read directly (mapped
+// staging: the layer split's hand-off rows, the window's inputs, the CPU pool's rows).  Allocated through an Intel
+// card's queue they are Level Zero host memory, which a CUDA card cannot address; registered with CUDA as portable
+// pinned memory (cuMemHostRegister) the same address is valid in every CUDA context as well (unified addressing).
+// Without an NVIDIA card in the process (or outside a four-gpu build, STRATA_FOUR_GPU) these are sycl::malloc_host.
+#pragma once
+#include <sycl/sycl.hpp>
+#include <cstddef>
+
+#if defined(STRATA_FOUR_GPU)
+#include <cuda.h>
+#include <cstdio>
+#include <mutex>
+#endif
+
+namespace strata {
+
+#if defined(STRATA_FOUR_GPU)
+namespace detail {
+// a CUDA context to register in (the first NVIDIA card's primary context), or nullptr without one
+inline CUcontext cuda_register_ctx() {
+    static CUcontext ctx = [] {
+        bool any = false;
+        for (const auto& d : sycl::device::get_devices(sycl::info::device_type::gpu))
+            any |= d.get_backend() == sycl::backend::ext_oneapi_cuda;
+        CUcontext c = nullptr;
+        CUdevice dev;
+        if (any && cuInit(0) == CUDA_SUCCESS && cuDeviceGet(&dev, 0) == CUDA_SUCCESS)
+            cuDevicePrimaryCtxRetain(&c, dev);
+        return c;
+    }();
+    return ctx;
+}
+}  // namespace detail
+
+inline void make_host_visible(void* p, size_t bytes) {
+    CUcontext ctx = detail::cuda_register_ctx();
+    if (p == nullptr || bytes == 0 || ctx == nullptr) return;
+    cuCtxPushCurrent(ctx);
+    const CUresult r = cuMemHostRegister(p, bytes, CU_MEMHOSTREGISTER_PORTABLE | CU_MEMHOSTREGISTER_DEVICEMAP);
+    if (r != CUDA_SUCCESS && r != CUDA_ERROR_HOST_MEMORY_ALREADY_REGISTERED)
+        std::fprintf(stderr, "strata: four-gpu: cuMemHostRegister of %zu bytes failed (%d)\n", bytes, (int) r);
+    CUcontext prev;
+    cuCtxPopCurrent(&prev);
+}
+#else
+inline void make_host_visible(void*, size_t) {}
+#endif
+
+inline void* malloc_host(size_t bytes, const sycl::queue& q) {
+    void* p = sycl::malloc_host(bytes, q);
+    make_host_visible(p, bytes);
+    return p;
+}
+template <typename T>
+inline T* malloc_host(size_t count, const sycl::queue& q) {
+    T* p = sycl::malloc_host<T>(count, q);
+    make_host_visible(p, count * sizeof(T));
+    return p;
+}
+
+}  // namespace strata
