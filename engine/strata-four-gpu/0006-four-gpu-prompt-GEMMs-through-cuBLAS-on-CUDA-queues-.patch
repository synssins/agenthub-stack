--- /dev/null
+++ b/sycl/include/strata/prefill/gemm_ex.hpp
@@ -0,0 +1,83 @@
+// four-gpu: the prompt path's GEMMs on any card.  dpct::blas::gemm is oneMKL, which runs on Intel GPUs only; on a
+// CUDA queue (an NVIDIA card in a four-gpu build, STRATA_CUBLAS_INTEROP) the same call goes to cublasGemmEx on the
+// queue's own CUDA stream through a SYCL host_task.  Same arguments as dpct::blas::gemm, same column-major meaning.
+#pragma once
+#include <sycl/sycl.hpp>
+#include <dpct/dpct.hpp>
+#include <dpct/blas_utils.hpp>
+
+#if defined(STRATA_CUBLAS_INTEROP)
+#include <sycl/ext/oneapi/experimental/backend/cuda.hpp>
+#include <cublas_v2.h>
+#include <cuda.h>
+#include <cstdio>
+#include <map>
+#include <mutex>
+#endif
+
+namespace strata::prefill {
+
+#if defined(STRATA_CUBLAS_INTEROP)
+namespace detail {
+inline cudaDataType cuda_type(dpct::library_data_t t) {
+    switch (t) {
+        case dpct::library_data_t::real_half: return CUDA_R_16F;
+        case dpct::library_data_t::real_bfloat16: return CUDA_R_16BF;
+        default: return CUDA_R_32F;
+    }
+}
+inline cublasOperation_t cuda_op(oneapi::mkl::transpose t) {
+    return t == oneapi::mkl::transpose::nontrans ? CUBLAS_OP_N : CUBLAS_OP_T;
+}
+// one cuBLAS handle per CUDA context (each card's), made on first use inside that card's host_task
+inline cublasHandle_t cublas_for(CUcontext ctx) {
+    static std::mutex m;
+    static std::map<CUcontext, cublasHandle_t> handles;
+    std::lock_guard<std::mutex> g(m);
+    auto it = handles.find(ctx);
+    if (it != handles.end()) return it->second;
+    cublasHandle_t h = nullptr;
+    if (cublasCreate(&h) != CUBLAS_STATUS_SUCCESS) {
+        std::fprintf(stderr, "strata: cublasCreate failed\n");
+        return nullptr;
+    }
+    cublasSetMathMode(h, CUBLAS_DEFAULT_MATH);
+    handles[ctx] = h;
+    return h;
+}
+}  // namespace detail
+#endif
+
+inline int gemm_ex(dpct::blas::descriptor_ptr handle, oneapi::mkl::transpose ta, oneapi::mkl::transpose tb, int m,
+                   int n, int k, const float* alpha, const void* a, dpct::library_data_t at, int lda, const void* b,
+                   dpct::library_data_t bt, int ldb, const float* beta, void* c, dpct::library_data_t ct, int ldc,
+                   dpct::compute_type comp) {
+#if defined(STRATA_CUBLAS_INTEROP)
+    sycl::queue& q = handle->get_queue();
+    if (q.get_backend() == sycl::backend::ext_oneapi_cuda) {
+        const float al = *alpha, be = *beta;
+        q.submit([&](sycl::handler& h) {
+             h.host_task([=](sycl::interop_handle ih) {
+                 CUstream s = ih.get_native_queue<sycl::backend::ext_oneapi_cuda>();
+                 CUcontext ctx = nullptr;
+                 cuCtxGetCurrent(&ctx);
+                 cublasHandle_t cb = detail::cublas_for(ctx);
+                 if (cb == nullptr) return;
+                 cublasSetStream(cb, s);
+                 const cublasStatus_t st = cublasGemmEx(
+                     cb, detail::cuda_op(ta), detail::cuda_op(tb), m, n, k, &al, a, detail::cuda_type(at), lda, b,
+                     detail::cuda_type(bt), ldb, &be, c, detail::cuda_type(ct), ldc, CUBLAS_COMPUTE_32F,
+                     CUBLAS_GEMM_DEFAULT);
+                 if (st != CUBLAS_STATUS_SUCCESS)
+                     std::fprintf(stderr, "strata: cublasGemmEx failed (%d), m %d n %d k %d\n", (int) st, m, n, k);
+                 cuStreamSynchronize(s);   // a host_task ends when this returns: the stream's work must be done
+             });
+         });
+        return 0;
+    }
+#endif
+    return DPCT_CHECK_ERROR(dpct::blas::gemm(handle, ta, tb, m, n, k, alpha, a, at, lda, b, bt, ldb, beta, c, ct, ldc,
+                                             comp));
+}
+
+}  // namespace strata::prefill
