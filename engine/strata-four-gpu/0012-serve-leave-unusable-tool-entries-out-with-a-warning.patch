         self.assertEqual(ids[1][:len(first) - 8], first[:len(first) - 8])   # all but the generation header
 
 
+class MixedTools(unittest.TestCase):
+    """Homarr's assistant (Vercel AI SDK) sent one unusable entry among its MCP tools and every message was a 400.
+    Entries that are not usable function tools - no name, an empty one, a "function" that is not an object, another
+    "type" (the SDK's provider-defined tools) - are left out with a warning; the request goes on with the rest."""
+    GOOD = {"type": "function", "function": {"name": "get_time", "description": "time",
+                                            "parameters": {"type": "object", "properties": {"zone": {"type": "string"}}}}}
+    MIXED = [GOOD, {"type": "function", "function": {"name": "", "parameters": {"type": "object", "properties": {}}}},
+             {"type": "provider-defined", "id": "x.web_search", "args": {}},
+             {"type": "function", "function": "nope"}, {"description": "no name at all"}]
+
+    @classmethod
+    def setUpClass(cls):
+        tok = ByteTokenizer()
+        cls.engine = RecordingPrompt(tok, "</think>\n\n<tool_call>\n<function=get_time>\n<parameter=zone>\nUTC\n"
+                                          "</parameter>\n</function>\n</tool_call>", max_context=CTX)
+        cls.svc = Service(cls.engine, tok, ChatTemplate(ROOT / "serve/chat_template.jinja"))
+        cls.httpd = serve(cls.svc, port=0)
+        cls.base = f"http://127.0.0.1:{cls.httpd.server_address[1]}"
+
+    @classmethod
+    def tearDownClass(cls):
+        cls.httpd.shutdown()
+        cls.httpd.server_close()
+
+    def post(self, path, body, raw=False):
+        req = urllib.request.Request(self.base + path, data=json.dumps(body).encode(),
+                                     headers={"Content-Type": "application/json", "anthropic-version": "2023-06-01"})
+        try:
+            with urllib.request.urlopen(req, timeout=30) as r:
+                data = r.read()
+                return r.status, (data.decode() if raw else json.loads(data))
+        except urllib.error.HTTPError as e:
+            with e:
+                return e.code, json.loads(e.read())
+
+    def prompt_text(self):
+        return bytes(i for i in self.engine.last_ids if i < 256).decode("utf-8", "replace")
+
+    def body(self, **kw):
+        return {"model": "x", "max_tokens": 512, "messages": [{"role": "user", "content": "What time is it?"}],
+                "tools": self.MIXED, **kw}
+
+    def test_mixed_tools_are_a_200_with_only_the_usable_ones(self):
+        status, b = self.post("/v1/chat/completions", self.body())
+        self.assertEqual(status, 200, b)
+        prompt = self.prompt_text()
+        self.assertIn("get_time", prompt)
+        self.assertNotIn("x.web_search", prompt)
+        self.assertNotIn("no name at all", prompt)
+        choice = b["choices"][0]
+        self.assertEqual(choice["finish_reason"], "tool_calls")
+        calls = choice["message"]["tool_calls"]
+        self.assertEqual([c["function"]["name"] for c in calls], ["get_time"])
+        self.assertEqual(json.loads(calls[0]["function"]["arguments"]), {"zone": "UTC"})
+
+    def test_mixed_tools_stream(self):
+        status, text = self.post("/v1/chat/completions", self.body(stream=True), raw=True)
+        self.assertEqual(status, 200, text)
+        self.assertIn('"get_time"', text)
+        self.assertIn("[DONE]", text)
+
+    def test_anthropic_shape_and_nothing_usable(self):
+        msgs = [{"role": "user", "content": "hi"}]
+        status, b = self.post("/v1/messages", {"model": "x", "max_tokens": 8, "messages": msgs, "tools": [
+            {"name": "get_time", "input_schema": {"type": "object"}}, {"description": "no name"}]})
+        self.assertEqual(status, 200, b)
+        self.assertIn("get_time", self.prompt_text())
+        status, b = self.post("/v1/chat/completions", {"model": "x", "max_tokens": 8, "messages": msgs, "tools": [
+            {"type": "provider-defined", "id": "x.web_search"}, {"type": "function", "function": {"name": ""}}]})
+        self.assertEqual(status, 200, b)                # nothing usable left: as if no tools were sent
+        self.assertNotIn("x.web_search", self.prompt_text())
+
+
 class ToolOrder(unittest.TestCase):
     """A tool set that comes back in another order is put back in the order it was first seen (RealScaniX, #1624): the
     template renders the tool list before the system prompt, so a client whose MCP tools register in a varying order
