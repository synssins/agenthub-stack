From: AgentHub stack <noreply@example.invalid>
Date: Mon, 19 Oct 2026 19:27:54 +0000
Subject: [PATCH 12/17] serve: leave unusable tool entries out with a warning
 instead of a 400 (Homarr / Vercel AI SDK provider-defined tools)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 serve/frontend.py    | 39 +++++++++++++++++------
 serve/test_server.py | 76 ++++++++++++++++++++++++++++++++++++++++++--
 2 files changed, 104 insertions(+), 11 deletions(-)

diff --git a/serve/frontend.py b/serve/frontend.py
index 3fda9c5..e2df8cd 100644
--- a/serve/frontend.py
+++ b/serve/frontend.py
@@ -474,11 +474,17 @@ def _stable_tool_order(tools: list[dict], name_of) -> list[dict]:
 def _tool_list(value, wrapper: str | None) -> list[dict]:
     """#592: a request's "tools" as a list of tool objects, each with a name - in the OpenAI shape
     {"type": "function", "function": {"name": ...}} (`wrapper` "function"; a bare {"name": ...} is still taken), or
-    in the Anthropic shape {"name": ...} (`wrapper` None).  A value that is not (a string such as "auto", a list of
-    names, an object without a name) is a ValueError - a 400 naming the field - where it used to take the request
-    thread down with no reply at all.  No value (or an empty one) is no tools, as always.  A tool's schema -
-    "parameters" in the OpenAI shape, "input_schema" in the Anthropic one - is an object when it is there, for the
-    same reason: a string or a list passed and raised later instead, on the model's first call of that tool."""
+    in the Anthropic shape {"name": ...} (`wrapper` None).  A value that is not a list of objects (a string such as
+    "auto", a list of names, a single object) is a ValueError - a 400 naming the field - where it used to take the
+    request thread down with no reply at all.  No value (or an empty one) is no tools, as always.
+
+    An entry that is not a usable function tool - another "type" (the Vercel AI SDK's provider-defined tools,
+    e.g. {"type": "provider-defined", "id": "x.web_search"}), a "function" that is not an object, no name or an
+    empty one - is left out with a warning naming it, as vLLM and llama.cpp do, instead of failing the whole request
+    (Homarr's assistant sent one such entry among its MCP tools and got a 400 for every message).  Left-out entries
+    never reach the template, parse_tool_call or the stream parser; when none is left the request has no tools.
+    A named tool's schema - "parameters" in the OpenAI shape, "input_schema" in the Anthropic one - is an object when
+    it is there: a string or a list passed and raised later instead, on the model's first call of that tool."""
     if not value:
         return []
     shape = ('{"type": "function", "function": {"name": ..., "parameters": {...}}}' if wrapper else
@@ -488,17 +494,32 @@ def _tool_list(value, wrapper: str | None) -> list[dict]:
     except ValueError:
         raise ValueError(f"tools must be a list of tool objects, each {shape}") from None
     key = "parameters" if wrapper else "input_schema"
+
+    def fn_of(t: dict):
+        return t.get(wrapper, t) if wrapper and t.get("type") == wrapper else t
+
+    kept = []
     for i, t in enumerate(tools):
-        fn = t.get(wrapper, t) if wrapper and t.get("type") == wrapper else t
-        if not isinstance(fn, dict) or not isinstance(fn.get("name"), str) or not fn["name"]:
-            raise ValueError(f"tools[{i}] has no name: each tool must be {shape}")
+        kind = t.get("type")
+        fn = fn_of(t)
+        why = None
+        if wrapper and kind is not None and kind != wrapper:
+            why = f'type {kind!r} is not "{wrapper}"'
+        elif not isinstance(fn, dict):
+            why = f'"{wrapper}" is not an object'
+        elif not isinstance(fn.get("name"), str) or not fn["name"]:
+            why = "no name"
+        if why is not None:
+            print(f"[strata] tools[{i}] left out ({why}; each tool must be {shape}): {json.dumps(t)[:200]}", flush=True)
+            continue
         schema = fn.get(key)
         if schema is not None and not isinstance(schema, dict):
             # it reached parse_tool_call and the stream parser as the tool's schema, whose .get("properties") raised
             # AttributeError in the request thread - after the 200 and whatever the model had said before the call
             raise ValueError(f'tools[{i}] ({fn["name"]}): "{key}" must be an object (the JSON schema of its '
                              f"parameters), not {type(schema).__name__}")
-    return _stable_tool_order(tools, lambda t: (t.get(wrapper, t) if wrapper and t.get("type") == wrapper else t)["name"])
+        kept.append(t)
+    return _stable_tool_order(kept, lambda t: fn_of(t)["name"])
 
 
 def tool_arguments(raw) -> dict:
