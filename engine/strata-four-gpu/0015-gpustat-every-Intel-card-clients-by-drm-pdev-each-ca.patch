From 4331660f7bb49a7b1ce1f8e55570ad76d0ec7f66 Mon Sep 17 00:00:00 2001
From: AgentHub stack <noreply@example.invalid>
Date: Mon, 19 Oct 2026 19:35:31 +0000
Subject: [PATCH 15/17] gpustat: every Intel card (clients by drm-pdev, each
 card's hwmon), B60 name/VRAM; the Monitor reads each card's own entry

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 sycl/serve/xe_telemetry.py |  10 +++-
 sycl/tools/gpustat.py      | 110 +++++++++++++++++++++++--------------
 2 files changed, 78 insertions(+), 42 deletions(-)

diff --git a/sycl/serve/xe_telemetry.py b/sycl/serve/xe_telemetry.py
index 137667e..740f07b 100644
--- a/sycl/serve/xe_telemetry.py
+++ b/sycl/serve/xe_telemetry.py
@@ -59,7 +59,15 @@ class _XeGpu:
             import json
             with open(self.STAT) as f:
                 st = json.load(f)
-            return st if time.time() - float(st.get("ts", 0)) < 15 else None
+            if time.time() - float(st.get("ts", 0)) >= 15:
+                return None
+            # this card's readings: the sampler's "cards" (one per Intel card, by PCI address); a sampler without
+            # them wrote one card's - taken only for that card, not repeated on every card of a split
+            pci = os.path.basename(self.dev or "")
+            for c in st.get("cards") or []:
+                if c.get("pci") == pci:
+                    return c
+            return st if not st.get("cards") and st.get("pci") in (None, pci) else None
         except (OSError, ValueError):
             return None
 
diff --git a/sycl/tools/gpustat.py b/sycl/tools/gpustat.py
index fa7a73a..11b4e0a 100644
--- a/sycl/tools/gpustat.py
+++ b/sycl/tools/gpustat.py
@@ -7,12 +7,14 @@ Writes /run/gpustat.json every INTERVAL s; Strata's web app (serve/telemetry.py)
   power_w / pkg_power_w (energy counter deltas over a POWER_WINDOW s window: the counters update in
   bursts, so a 3 s delta swings 0.6 <-> 48 W), power_cap_w, fan_rpm, freq_mhz, the PCIe link the card
   trained at (the first upstream port wider than x1 - the card's own functions sit behind an internal
-  x1 switch), the hottest VRAM channel, and the host's 1-minute load. Device totals only.
+  x1 switch), the hottest VRAM channel, and the host's 1-minute load. Device totals per card: every Intel card
+  on xe is sampled (each drm client counts toward its own card, by drm-pdev), in "cards" ([{..., "pci"}], sysfs
+  order); the top-level fields are the first card's, as before.
 Without it the Monitor tab still shows temperature, power and the PCIe link (sysfs), but not load or VRAM: xe
 reports those per client in /proc/*/fdinfo, which only root can read.
 Install:  sudo install -m 755 sycl/tools/gpustat.py /usr/local/sbin/
           sudo install -m 644 sycl/tools/gpustat.service /etc/systemd/system/ && sudo systemctl enable --now gpustat
-Env: GPUSTAT_INTERVAL (s), GPUSTAT_POWER_WINDOW (s), GPUSTAT_PCI (the card, e.g. 0000:03:00.0; default the first
+Env: GPUSTAT_INTERVAL (s), GPUSTAT_POWER_WINDOW (s), GPUSTAT_PCI (one card only, e.g. 0000:03:00.0; default every
 Intel GPU on xe), GPUSTAT_VRAM_MB (the total; default the card's largest PCI BAR, which maps all of VRAM with
 resizable BAR - a little above what the runtime reports as usable).
 """
@@ -20,39 +22,47 @@ import collections, glob, json, os, subprocess, time
 
 OUT = "/run/gpustat.json"
 INTERVAL = float(os.environ.get("GPUSTAT_INTERVAL", "3"))   # each sample scans /proc/*/fd; keep it modest
-NAMES = {"e223": "Intel(R) Arc(TM) Pro B70 Graphics"}
+NAMES = {"e223": "Intel(R) Arc(TM) Pro B70 Graphics", "e211": "Intel(R) Arc(TM) Pro B60 Graphics",
+         "e221": "Intel(R) Arc(TM) Pro B60 Graphics"}
+VRAM_MB = {"e223": 32768, "e211": 24576, "e221": 24576}   # the B60's BAR is 32 GiB for 24 GiB of VRAM
 
 
-def find_card():
-    """The first Intel GPU on the xe driver (it has tile*/gt*), as a PCI address."""
+def find_cards():
+    """Every Intel GPU on the xe driver (it has tile*/gt*), as PCI addresses in sysfs order."""
+    out = []
     for d in sorted(glob.glob("/sys/class/drm/card[0-9]*/device")):
         try:
             if open(f"{d}/vendor").read().strip() == "0x8086" and glob.glob(f"{d}/tile*/gt*"):
-                return os.path.basename(os.path.realpath(d))
+                pci = os.path.basename(os.path.realpath(d))
+                if pci not in out:
+                    out.append(pci)
         except OSError:
             continue
-    return None
+    return out
 
 
-PCI = os.environ.get("GPUSTAT_PCI") or find_card() or "0000:00:00.0"
+PCIS = [os.environ["GPUSTAT_PCI"]] if os.environ.get("GPUSTAT_PCI") else (find_cards() or ["0000:00:00.0"])
 
 
-def vram_total_mb():
+def vram_total_mb(pci):
     if os.environ.get("GPUSTAT_VRAM_MB"):
         return int(os.environ["GPUSTAT_VRAM_MB"])
+    dev_id = (rd(f"/sys/bus/pci/devices/{pci}/device", "0x0") or "0x0")[2:]
+    if dev_id in VRAM_MB:
+        return VRAM_MB[dev_id]
     try:                                   # with resizable BAR the largest BAR maps all of VRAM
         sizes = [int(e, 16) - int(s, 16) + 1 for s, e, _ in
-                 (l.split() for l in open(f"/sys/bus/pci/devices/{PCI}/resource") if l.strip())]
+                 (l.split() for l in open(f"/sys/bus/pci/devices/{pci}/resource") if l.strip())]
         return max(sizes) // 2**20
     except (OSError, ValueError):
         return 0
 
 
-def card_name(dev_id):
+def card_name(dev_id, pci):
     if dev_id in NAMES:
         return NAMES[dev_id]
     try:
-        out = subprocess.run(["lspci", "-mm", "-s", PCI], capture_output=True, text=True, timeout=5).stdout
+        out = subprocess.run(["lspci", "-mm", "-s", pci], capture_output=True, text=True, timeout=5).stdout
         parts = [p.strip('"') for p in out.split('" "')]
         if len(parts) >= 3 and parts[2]:
             return parts[2]
@@ -61,13 +71,12 @@ def card_name(dev_id):
     return f"Intel GPU 8086:{dev_id}"
 
 
-TOTAL_MB = vram_total_mb()
 POWER_WINDOW = float(os.environ.get("GPUSTAT_POWER_WINDOW", "15"))
 GEN = {"2.5": 1, "5.0": 2, "8.0": 3, "16.0": 4, "32.0": 5, "64.0": 6}
 
-def pcie_link():
+def pcie_link(pci):
     """The link the card trained at: walk up from the GPU function to the first port wider than x1."""
-    d = os.path.realpath(f"/sys/bus/pci/devices/{PCI}")
+    d = os.path.realpath(f"/sys/bus/pci/devices/{pci}")
     chain = []
     while d.startswith("/sys/devices/pci") and os.path.exists(f"{d}/current_link_speed"):
         chain.append(d); d = os.path.dirname(d)
@@ -81,9 +90,10 @@ def pcie_link():
             return {"cur": cur, "card_max": link(p, "max"), "slot_max": link(root, "max")}
     return None
 
-def hwmon_dir():
-    for n in glob.glob("/sys/class/hwmon/hwmon*/name"):
-        if open(n).read().strip() == "xe":
+def hwmon_dir(pci):
+    """The card's own xe hwmon (under its PCI device); the first xe one anywhere when it has none there."""
+    for n in glob.glob(f"/sys/bus/pci/devices/{pci}/hwmon/hwmon*/name") + glob.glob("/sys/class/hwmon/hwmon*/name"):
+        if rd(n) == "xe":
             return os.path.dirname(n)
     return None
 
@@ -101,7 +111,7 @@ def hw_temps(h):
     return t
 
 def clients():
-    """{client_id: {pid, comm, vram_kb, cycles, total_cycles}} across all processes."""
+    """{client_id: {pid, comm, pdev, vram_kb, cycles, total_cycles}} across all processes."""
     res = {}
     for pdir in glob.glob("/proc/[0-9]*"):
         try:
@@ -121,27 +131,35 @@ def clients():
             kb = lambda k: int(info.get(k, "0").split()[0] or 0)
             cyc = max(kb("drm-cycles-rcs"), kb("drm-cycles-ccs"))
             tot = max(kb("drm-total-cycles-rcs"), kb("drm-total-cycles-ccs"))
-            res[cid] = {"pid": int(pdir[6:]), "comm": rd(f"{pdir}/comm", "?"),
+            res[cid] = {"pid": int(pdir[6:]), "comm": rd(f"{pdir}/comm", "?"), "pdev": info.get("drm-pdev", "").strip(),
                         "cg": rd(f"{pdir}/cgroup", ""), "vram_kb": kb("drm-resident-vram0"), "cycles": cyc, "total": tot}
     return res
 
-def main():
-    h = hwmon_dir()
-    dev_id = (rd(f"/sys/bus/pci/devices/{PCI}/device", "0x0") or "0x0")[2:]
-    name = card_name(dev_id)
-    prev = {}; t_prev = time.time()
-    ring = collections.deque()                  # (t, card uJ, pkg uJ) over the last POWER_WINDOW s
-    link = pcie_link(); link_t = time.time()
-    while True:
-        now = time.time(); dt = max(now - t_prev, 1e-3)
-        cl = clients()
+class Card:
+    """One card's sampler state: its hwmon, name, the energy ring for power, and the PCIe link."""
+
+    def __init__(self, pci):
+        self.pci = pci
+        self.h = hwmon_dir(pci)
+        self.name = card_name((rd(f"/sys/bus/pci/devices/{pci}/device", "0x0") or "0x0")[2:], pci)
+        self.total_mb = vram_total_mb(pci)
+        self.ring = collections.deque()          # (t, card uJ, pkg uJ) over the last POWER_WINDOW s
+        self.link = pcie_link(pci)
+        self.link_t = time.time()
+
+    def sample(self, now, cl, prev, alone):
+        """This card's readings; `cl`/`prev`: every drm client now and at the last sample.  A client without a
+        drm-pdev counts toward the card only when it is the only one sampled (`alone`, as before)."""
+        mine = {cid: c for cid, c in cl.items() if c["pdev"] == self.pci or (alone and not c["pdev"])}
         busy = 0.0
-        for cid, c in cl.items():
+        for cid, c in mine.items():
             p = prev.get(cid)
             if p and c["total"] > p["total"]:
                 busy += (c["cycles"] - p["cycles"]) / (c["total"] - p["total"]) * 100
+        h = self.h
         e = int(rd(f"{h}/energy1_input", "0") or 0) if h else 0
         e2 = int(rd(f"{h}/energy2_input", "0") or 0) if h else 0
+        ring = self.ring
         ring.append((now, e, e2))
         while len(ring) > 2 and now - ring[1][0] >= POWER_WINDOW:
             ring.popleft()
@@ -149,15 +167,15 @@ def main():
         span = now - t0
         power = (e - ea) / 1e6 / span if span >= 2.5 and e >= ea else None
         pkg_power = (e2 - eb) / 1e6 / span if span >= 2.5 and e2 >= eb else None
-        if now - link_t > 30:                   # the link can retrain (power saving, errors): re-read it
-            link = pcie_link(); link_t = now
+        if now - self.link_t > 30:               # the link can retrain (power saving, errors): re-read it
+            self.link = pcie_link(self.pci); self.link_t = now
         temps = hw_temps(h) if h else {}
         vram_ch = [v for k, v in temps.items() if k.startswith("vram_ch_")]
         cap = rd(f"{h}/power1_cap") if h else None
-        used_mb = sum(c["vram_kb"] for c in cl.values()) // 1024
-        out = {
-            "name": name, "pci": PCI, "ts": now,
-            "vram_used_mb": used_mb, "vram_total_mb": TOTAL_MB,
+        freq = glob.glob(f"/sys/bus/pci/devices/{self.pci}/tile0/gt0/freq0/act_freq")
+        return {
+            "name": self.name, "pci": self.pci, "ts": now,
+            "vram_used_mb": sum(c["vram_kb"] for c in mine.values()) // 1024, "vram_total_mb": self.total_mb,
             "busy_pct": round(min(busy, 100), 1),
             "temp_pkg": temps.get("pkg"), "temp_vram": temps.get("vram"),
             "power_w": None if power is None else round(power, 1),
@@ -165,18 +183,28 @@ def main():
             "power_cap_w": round(int(cap) / 1e6) if cap and cap.isdigit() and int(cap) > 0 else None,
             "temp_vram_max": max(vram_ch) if vram_ch else None,
             "temp_pcie": temps.get("pcie"), "temp_mctrl": temps.get("mctrl"),
-            "pcie": link,
+            "pcie": self.link,
             "host_load1": round(os.getloadavg()[0], 2), "host_cpus": os.cpu_count(),
             "energy_j": round(e / 1e6, 1),           # cumulative card energy (hwmon energy1 = "card", uJ)
             "fan_rpm": int(rd(f"{h}/fan1_input", "0") or 0) if h else None,
-            "freq_mhz": int(rd(glob.glob(f"/sys/bus/pci/devices/{PCI}/tile0/gt0/freq0/act_freq")[0], "0") or 0)
-                        if glob.glob(f"/sys/bus/pci/devices/{PCI}/tile0/gt0/freq0/act_freq") else None,
+            "freq_mhz": int(rd(freq[0], "0") or 0) if freq else None,
         }
+
+
+def main():
+    cards = [Card(pci) for pci in PCIS]
+    prev = {}
+    while True:
+        now = time.time()
+        cl = clients()
+        per = [c.sample(now, cl, prev, len(cards) == 1) for c in cards]
+        out = dict(per[0], cards=per)              # the first card's fields at the top, as before
         tmp = OUT + ".tmp"
         with open(tmp, "w") as f: json.dump(out, f)
         os.chmod(tmp, 0o644); os.replace(tmp, OUT)
-        prev, t_prev = cl, now
+        prev = cl
         time.sleep(INTERVAL)
 
+
 if __name__ == "__main__":
     main()
